    {
      "name": "Waterline motif",
      "source": "assets/motifs/BrandWaterline.tsx",
      "destination": "frontend/src/components/brand/BrandWaterline.tsx",
      "protected": false
    },
    {
      "name": "Icon SVG foundation",
      "source": "assets/ui-icons/IconBase.tsx",
      "destination": "frontend/src/components/icons/IconBase.tsx",
      "protected": false
    },
    {
      "name": "Category icons",
      "source": "assets/ui-icons/brand-categories.tsx",
      "destination": "frontend/src/components/icons/brand-categories.tsx",
      "protected": false
    },
    {
      "name": "Marketplace action icons",
      "source": "assets/ui-icons/marketplace-actions.tsx",
      "destination": "frontend/src/components/icons/marketplace-actions.tsx",
      "protected": false
    },
    {
      "name": "Navigation and communication icons",
      "source": "assets/ui-icons/navigation-communication.tsx",
      "destination": "frontend/src/components/icons/navigation-communication.tsx",
      "protected": false
    },
    {
      "name": "Status icons",
      "source": "assets/ui-icons/status.tsx",
      "destination": "frontend/src/components/icons/status.tsx",
      "protected": false
    }
  ],
  "core_palette": {
    "pine": "#173F37",
    "orange": "#EE9835",
    "cream": "#F7F6F1",
    "ink": "#16201D",
    "white": "#FFFFFF"
  }
